{
  "name": "@aircloud/template-backend-typescript",
  "version": "0.1.0",
  "description": "Production-grade Fastify v5 HTTP microservice template (Node 22, TypeScript strict, OpenTelemetry, OpenAPI 3.1).",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b83c4bc8e4d",
  "author": "AirCloud <opensource@aircloud.com.pl>",
  "homepage": "https://github.com/aircloud/template-backend-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aircloud/template-backend-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/aircloud/template-backend-typescript/issues"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "openapi": "tsx scripts/generate-openapi.ts",
    "sbom": "syft scan dir:. --output cyclonedx-json=sbom.cdx.json",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/sensible": "6.0.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.1",
    "@fastify/under-pressure": "9.0.3",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.55.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.57.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.1",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-logs": "0.57.1",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.1",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.7",
    "@vitest/coverage-v8": "2.1.8",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "pino-pretty": "13.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
