# Copy to .env for local development. NEVER commit a real .env.
# All values are validated by src/config.ts (Zod) at startup.

# Runtime
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Service identity (OpenTelemetry resource + log base fields)
SERVICE_NAME=template-backend-typescript
SERVICE_VERSION=0.0.0-dev

# OpenTelemetry — disabled by default. Set OTEL_ENABLED=true and point the
# endpoint at your collector (e.g. http://localhost:4318) to enable export.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Lifecycle
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT=1048576
